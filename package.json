{
  "name": "scope-client-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:briefs": "node --env-file=.env scripts/test-briefs-slice.mjs",
    "test:assets": "node --env-file=.env scripts/test-brief-assets.mjs",
    "test:role": "node --env-file=.env scripts/test-db-role.mjs",
    "inspect": "node --env-file=.env scripts/inspect-briefs.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "sh -c 'set -a; . ./.env; set +a; DATABASE_URL=\"$ADMIN_DATABASE_URL\" prisma studio'",
    "email:test": "node --env-file=.env scripts/test-smtp.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@next/swc-darwin-x64": "^16.3.4",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "nodemailer": "^10.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
