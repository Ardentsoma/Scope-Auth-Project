# --- Database -------------------------------------------------------------
# Local PostgreSQL connection string for the app role.
# Matches docker-compose.yml if you use the bundled container, or your own
# local Postgres. The database is `scope_briefs`, which holds this slice and
# nothing else — keep it that way. An earlier shared `scope` database also
# carried another project's tables, which made a schema diff against it
# permanently noisy.
#
# The runtime role. It owns no tables, so the row-level security policies on
# `briefs` and `brief_assets` apply to it. Never point this at the owner role.
DATABASE_URL="postgresql://scope_app:app_secret@localhost:5432/scope_briefs"

# The owner role. Owners are exempt from row-level security, which is what lets
# Prisma Studio browse every brief. Used by `npm run db:studio` and by
# migrations. The application must never connect with this.
ADMIN_DATABASE_URL="postgresql://scope:scope_secret@localhost:5432/scope_briefs"

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie (HMAC-SHA-256). Generate a strong
# random value, e.g. `openssl rand -hex 32`. Keep it stable across restarts.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (SMTP) ---------------------------------------------------------
# For Gmail: host smtp.gmail.com, port 465, SMTP_USER = your Gmail address,
# SMTP_PASS = a 16-character App Password (Google Account > Security > App
# passwords; 2-Step Verification must be on). EMAIL_FROM must be the same
# address (or an identity verified with the provider).
#
# Leave SMTP_USER/SMTP_PASS blank to run in development mode, where emails are
# printed to the server console with an "[email:dev]" prefix instead of being
# sent. Use `npm run email:test` to probe the connection before testing an
# OTP flow.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SCOPE <you@gmail.com>"
# Set to "false" if your provider uses a self-signed certificate (rare).
# Set to "true" to keep a persistent connection pool for bulk resend runs.
SMTP_REJECT_UNAUTHORIZED="true"
SMTP_POOL="false"
# --- File storage -----------------------------------------------------------
# Brief documents live in Postgres, in the brief_assets.content column, so there
# is nothing to configure here. Downloads are streamed through the authorised
# API route; no bucket, no public URL.
